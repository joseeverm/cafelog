# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/cafelog?sslmode=require

# JWT — mínimo 32 caracteres aleatorios
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-chars
JWT_EXPIRES_IN=30d

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:5173
